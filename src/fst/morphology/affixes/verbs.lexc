+V+Act+Ind+Prs+Pl3:%>^V K ;
+V+Act+Ind+Prs+Pl3:%>v^A K ;
+V+Act+Ind+Prs+Pl3+Err/Orth:%>v^At K ;

+V+Pass+Ind+Prs:^AE^WG%>th^A^An K ;
