+V+InfMa+Ela:%>m^Ast^A K ;
+V+InfMa+Ill:%>^HMET2mh^A^An K ; !
+V+InfMa+Ill:^HMETA%>h^V^Vn K ; !isthuun, seishoon, laulhaan
+V+InfMa+Ill:^HMET2%>h^V^Vn K ; !lauhlaan
+V+InfMa+Ill:%>mh^A^An K ; ! generate short formen last!
+V+InfMa+Ade:%>m^All^A K ; 
+V+InfMa+Abe:%>m^Att^A K ;
+V+InfMa+Ine:%>m^Ass^A K ;
+V+InfE+Ins:%>^E2Ien K ;

!! DERIVATION and PARTICIPFORMS
+V+Der/minen:mi nen ; 
+V+Act+PrsPrc:%>v^A x3 ;
+V+Pass+PrsPrc+Err/Orth:^AE^WG%>tt^Av^A x3 ; 
+V+Pass+PrsPrc+Err/Orth:^AE^WG%>tt^Avv^A x3 ; 
+V+Pass+PrsPrc:^AE^WG%>tt^Av^A x3 ; 
+V+AgPrc:%>m^A K ;

!! Forms not used in dictionary
+V+Pass+Ind+Prs+ConNeg:^WG%>t^A K ; !"ei annetta" CHECK a>e
+V+Pass+Ind+Prt+ConNeg:^WG%>t^U K ; !"ei annettu" CHECK a>e
+V+Act+Cond+ConNeg:%>^E2Iisi K ; !CHECK EK same as +V+Act+Cond+Sg3?
+V+Inf+Tra:%>^Akse PxK ; !CHECK EK used?


LEXICON v1_var  !!≈ * **@CODE@** !Test mahtaa>mahtan & mahan !TBC - where does it occur?
v1 ;
