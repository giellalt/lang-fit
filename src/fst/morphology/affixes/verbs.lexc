+V+Act+Cond+Pl1+Err/Orth:%>^E2Isim^A K ; 
+V+Act+Cond+Pl2:%>i4sitt^A K ;
+V+Act+Cond+Pl2+Err/Orth:%>^E2Isitt^A K ;
+V+Act+Cond+Pl3:%>i4sit K ;
+V+Act+Cond+Pl3+Err/Orth:%>i4siv^A K ;
+V+Act+Cond+Pl3:%>i4sivv^A K ; 
+V+Act+Cond+Pl3:%>i4siv^A K ; 
+V+Act+Cond+Pl3+Err/Orth:%>^E2Isit K ;
+V+Act+Cond+Pl3+Err/Orth:%>^E2Isiv^A K ;
+V+Act+Cond+Pl3+Err/Orth:%>^E2Isivv^A K ; 

+V+Pass+Cond:^AE^WG%>tt^A%>^E2Iis K ;  !+V+Pass+Cond+ConNeg but CHECK dictionary link
+V+Pass+Cond+Err/Orth:^AE^WG%>tt^A%>s K ; 
+V+Pass+Cond+ConNeg:^AE^WG%>tt^A%>^E2Iis K ; 

+V+InfE+Ine:%>^E2Iess^A K ;
