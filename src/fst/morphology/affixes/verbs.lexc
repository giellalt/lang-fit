+V+Act+Ind+Prt+Pl3+Err/Orth:%>i3v^A K ; 
+V+Act+Ind+Prt+Pl3+Err/Orth:%>i3v^At K ; !
+V+Act+Ind+Prt+Pl3:^AE^WG%>thiin K ;

+V+Pass+Ind+Prt:^AE^WG%>thiin K ;
+V+Neg+Act+Imprt+ConNeg+Sg2:^WG # ; !plus älä (älä anna)
+V+Neg+Act+Imprt+ConNeg+Pl2:%>k^O # ; !plus älä (älkää antako)

+V+Act+Imprt+Sg2:^WG # ;
+V+Act+Imprt+Sg2+Err/Orth: # ; !anta
+V+Act+Imprt+Sg:%>kh^O^On # ; !CHECK all verbgroups -- when used?
+V+Act+Imprt+Pl2:%>k^A^A # ;
+V+Act+Imprt+Pl3:%>kh^O^Ot # ; !CHECK all verbgroups -- when used?

+V+Act+PrfPrc+Sg+Nom:%>^N^U K ;
+V+Act+PrfPrc:%>^Nhee x3_oblique ; 
+V+Act+PrfPrc+Pl+Nom:%>n^HMET2%>heet K;
+V+Pass+PrfPrc+Sg+Nom:^AE^WG%>tt^U K ; 
+V+Pass+PrfPrc+Pl+Nom:^AE^WG%>t^Ut K ; 

+V+Act+Cond+Sg1:%>i4sin K ; !tuntisin
+V+Act+Cond+Sg1+Err/Orth:%>^E2Isin K ; 
